---
import '../styles/off-hours.css';
import HaerinBurst from './HaerinBurst.astro';
import GamingRig from './GamingRig.astro';
---
<section id="off-hours" class="off-hours panel" aria-labelledby="off-hours-title">
  <div class="section-label mono"><span>05 / A LITTLE MORE ME</span><span>MUSIC, GAMES &amp; EVERYTHING IN BETWEEN</span></div>
  <div class="off-hours-heading"><h2 id="off-hours-title">OFF<br /><span class="serif">the clock.</span></h2><p>Music I love.<br />Games I play.<br /><span lang="zh-CN">热爱，让生活有自己的节奏。</span></p></div>
  <div class="off-hours-grid">
    <article class="haerin-corner" aria-labelledby="haerin-title">
      <div class="haerin-topline mono"><span>NEWJEANS / FAN CORNER</span><span aria-hidden="true">♡</span></div>
      <div class="haerin-media">
        <HaerinBurst />
        <div class="haerin-photo-area haerin-collage" role="group" aria-label="姜海粼的四张照片拼贴">
          <span class="haerin-collage-note mono" aria-hidden="true">강해린 / A FEW FAVORITE FRAMES</span>
          <figure class="haerin-photo-card haerin-photo-dior"><img src="/images/haerin-photos/haerin-dior-2023.jpg" alt="姜海粼穿红色连衣裙出席 2023 年 Dior 活动，摄影：TV10。" width="799" height="1042" loading="lazy" decoding="async" /><figcaption class="mono">DIOR / 2023</figcaption></figure>
          <figure class="haerin-photo-card haerin-photo-mma"><img src="/images/haerin-photos/haerin-mma-2023.jpg" alt="姜海粼扎马尾、穿白色外套出席 2023 年 Melon Music Awards，摄影：TenAsia。" width="595" height="889" loading="lazy" decoding="async" /><figcaption class="mono">MMA / 2023</figcaption></figure>
          <figure class="haerin-portrait"><img src="/images/haerin-seoul-fashion-week.jpg" alt="姜海粼（Haerin）出席 2024 年首尔时装周，摄影：TV10。" width="624" height="872" loading="lazy" decoding="async" /><figcaption class="mono">HAERIN / SEOUL, 2024</figcaption></figure>
          <figure class="haerin-photo-card haerin-photo-olens"><img src="/images/haerin-photos/haerin-olens-2023.jpg" alt="浅棕色长发的姜海粼在 NewJeans × OLENS 2023 年宣传中的近景肖像，摄影：OLensglobal。" width="841" height="956" loading="lazy" decoding="async" /><figcaption class="mono">OLENS / 2023</figcaption></figure>
        </div>
      </div>
      <h3 id="haerin-title">HAERIN<span lang="zh-CN">姜海粼</span></h3>
      <div class="haerin-bottomline"><p>A little space for my favorite.<br /><span lang="zh-CN">NewJeans 姜海粼的粉丝。</span></p><span class="haerin-spark" aria-hidden="true">✳</span></div>
      <p class="haerin-credit">Photos: TV10 · OLensglobal / <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer">CC BY 3.0</a><br />TenAsia / <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a> · <a href="/HAERIN-PHOTOS.md">Sources &amp; photo credits ↗</a></p>
    </article>
    <GamingRig />
  </div>
</section>
