---
import '../styles/off-hours.css';
import HaerinBurst from './HaerinBurst.astro';
import GamingRig from './GamingRig.astro';
---
<section id="off-hours" class="off-hours panel" aria-labelledby="off-hours-title">
  <div class="section-label mono"><span>05 / A LITTLE MORE ME</span><span>MUSIC, GAMES &amp; EVERYTHING IN BETWEEN</span></div>
  <div class="off-hours-heading"><h2 id="off-hours-title">OFF<br /><span class="serif">the clock.</span></h2><p>Music I love.<br />Games I play.<br /><span lang="zh-CN">热爱，让生活有自己的节奏。</span></p></div>
  <div class="off-hours-grid">
    <article class="haerin-corner" aria-labelledby="haerin-title">
      <div class="haerin-topline mono"><span>NEWJEANS / FAN CORNER</span><span aria-hidden="true">♡</span></div>
      <HaerinBurst />
      <div class="haerin-photo-area">
        <span class="haerin-side-note mono" aria-hidden="true">강해린 · 姜海粼</span>
        <figure class="haerin-portrait"><img src="/images/haerin-seoul-fashion-week.jpg" alt="姜海粼（Haerin）出席 2024 年首尔时装周，摄影：TV10。" width="624" height="872" loading="lazy" /><figcaption class="mono">HAERIN / SEOUL, 2024</figcaption></figure>
        <svg class="haerin-cat-mark" viewBox="0 0 100 100" aria-hidden="true"><path d="M18 78V24l22 16h20l22-16v54M18 65c8 14 19 20 32 20s24-6 32-20M30 56c4-5 10-5 14 0m12 0c4-5 10-5 14 0M44 68l6 5 6-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h3 id="haerin-title">HAERIN<span lang="zh-CN">姜海粼</span></h3>
      <div class="haerin-bottomline"><p>A little space for my favorite.<br /><span lang="zh-CN">NewJeans 姜海粼的粉丝。</span></p><span class="haerin-spark" aria-hidden="true">✳</span></div>
      <p class="haerin-credit">Photo: <a href="https://commons.wikimedia.org/wiki/File:Haerin_Seoul_Fashion_Week_3.jpg" target="_blank" rel="noopener noreferrer">TV10 / Wikimedia Commons</a> · <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer">CC BY 3.0</a></p>
    </article>
    <GamingRig />
  </div>
</section>
