---
import '../styles/gaming-rig.css';
const ranks = [
  { game: 'APEX LEGENDS', rank: '大师', sub: 'MASTER', image: '/images/ranks/apex-master.png', className: 'apex', alt: 'APEX Legends 大师（Master）紫色段位徽章' },
  { game: 'CS:GO', rank: '完美黄金 S', sub: 'PERFECT WORLD', image: '/images/ranks/perfect-world-gold-s.svg', className: 'cs', alt: '完美黄金 S 原创金色 S 示意徽章，非官方段位素材' },
  { game: 'VALORANT', rank: '神话', sub: 'IMMORTAL', image: '/images/ranks/valorant-immortal.png', className: 'valorant', alt: 'VALORANT 神话（Immortal）通用段位徽章，不指定小段位' },
];
---
<article class="gaming-rig" aria-labelledby="gaming-rig-title">
  <div class="rig-topline mono"><span>PLAYER PROFILE</span><span aria-hidden="true">↗</span></div>
  <div class="rig-heading"><h3 id="gaming-rig-title">PLAY<br /><span class="serif">to win.</span></h3><p lang="zh-CN">认真研究，<br />也认真上分。</p></div>
  <ol class="rig-ranks" aria-label="我的游戏段位">{ranks.map(item => <li class={`rig-rank rig-rank-${item.className}`}>
    <div class="rig-emblem"><span class="rig-orbit" aria-hidden="true"></span><img src={item.image} alt={item.alt} width="180" height="180" loading="lazy" /></div>
    <h4>{item.game}</h4><p class="rig-rank-name" lang="zh-CN">{item.rank}</p><p class="rig-rank-sub mono">{item.sub}</p>
  </li>)}</ol>
  <p class="rig-badge-note mono">CS:GO 的 S 徽章为原创示意。</p>
  <section class="rig-setup" aria-labelledby="rig-setup-title">
    <div class="rig-setup-heading"><h4 id="rig-setup-title" class="mono">MY SETUP</h4><span class="mono">日常装备 / 02</span></div>
    <div class="rig-equipment">
      <figure class="rig-mouse"><div class="rig-gear-art"><img src="/images/gear/viper-v4-pro.svg" alt="雷蛇毒蝰 V4 Pro 鼠标的原创轮廓示意" width="220" height="240" loading="lazy" /></div><figcaption><span class="mono">01 / MOUSE</span><h5>Razer<br />Viper V4 Pro</h5><p lang="zh-CN">雷蛇毒蝰 V4 Pro</p></figcaption></figure>
      <figure class="rig-keyboard"><div class="rig-gear-art"><img src="/images/gear/iqunix-ev63.svg" alt="IQUNIX EV63 紧凑键盘的原创轮廓示意" width="420" height="240" loading="lazy" /></div><figcaption><span class="mono">02 / KEYBOARD</span><h5>IQUNIX<br />EV63</h5><p lang="zh-CN">我的键盘</p></figcaption></figure>
    </div>
    <p class="rig-gear-note mono">设备轮廓为示意绘制，配色不代表实物。</p>
  </section>
  <div class="rig-footer mono"><span>FOCUS. REACT. REPEAT.</span><span aria-hidden="true">+ + +</span></div>
</article>
