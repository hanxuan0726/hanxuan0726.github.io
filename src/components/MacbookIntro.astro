---
import '../styles/macbook-intro.css';
---
<section class="macbook-intro" data-macbook-intro aria-label="A desk in Shanghai: enter Hanxuan Zhou’s portfolio">
  <div class="macbook-intro-fallback"><a href="#portfolio-content">ENTER THE PORTFOLIO <span aria-hidden="true">↗</span></a></div>
  <div class="macbook-intro-stage" data-intro-stage>
    <div class="intro-tabletop" aria-hidden="true"></div>
    <div class="intro-desk-edge" aria-hidden="true"></div>
    <div class="intro-ambient-light" aria-hidden="true"></div>
    <div class="intro-desk-shadow" aria-hidden="true"></div>
    <div class="intro-meta"><span>HANXUAN ZHOU / PERSONAL PORTFOLIO</span><span>BASED IN SHANGHAI</span></div>
    <div class="intro-caption"><p>A small desk.<br /><em>A wider world.</em></p><span>从这里，进入我的世界。</span><small>MACBOOK AIR · M5</small></div>
    <div class="intro-camera" aria-hidden="true">
      <div class="intro-laptop" data-intro-laptop>
        <div class="intro-laptop-lid">
          <div class="intro-lid-shell"></div>
          <div class="intro-display-bezel">
            <div class="intro-display" data-intro-display>
              <div class="intro-screen-page" data-intro-screen></div>
            </div>
            <div class="intro-display-notch"><i></i></div>
          </div>
          <div class="intro-display-reflection"></div>
        </div>
        <div class="intro-hinge"></div>
        <div class="intro-laptop-base">
          <div class="intro-official-deck"><img src="/images/macbook-air/apple-air-top-clean.png" width="814" height="508" alt="" decoding="async" fetchpriority="high" /></div>
          <div class="intro-base-front"><i></i></div>
          <div class="intro-base-side"></div>
        </div>
      </div>
    </div>
    <div class="intro-bottom-bar"><p><span class="intro-scroll-line" aria-hidden="true"></span>SCROLL TO STEP INSIDE <span aria-hidden="true">↓</span></p><div><button type="button" data-intro-still>ENTER WITHOUT MOTION</button><a href="#portfolio-content" data-intro-skip>SKIP INTRO <span aria-hidden="true">↗</span></a></div></div>
    <div class="intro-progress" aria-hidden="true"><span data-intro-progress></span></div>
  </div>
</section>
<script>
  import '../scripts/macbook-intro';
</script>
