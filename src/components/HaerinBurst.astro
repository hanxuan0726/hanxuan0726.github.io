---
import '../styles/haerin-burst.css';
const stickers = [
  ['haerin-wave', 8, 29, 110, -15, 16], ['haerin-wink', 91, 31, 119, 16, -20],
  ['haerin-fly', 7, 49, 115, -24, 24], ['haerin-fly', 93, 53, 112, 27, -16],
  ['bunny', 9, 63, 87, -13, 15], ['haerin-wave', 90, 63, 88, 16, -22],
  ['super-shy', 29, 19, 128, -13, -11], ['newjeans', 76, 19, 132, 10, 14],
  ['haerin-star', 6, 17, 68, -17, 20], ['mint-heart', 94, 15, 56, 21, -16],
  ['pink-spark', 15, 39, 45, -12, 24], ['mint-heart', 88, 42, 47, 16, -17],
  ['pink-spark', 7, 59, 44, 14, 19], ['haerin-star', 95, 61, 66, 13, -15],
] as const;
---
<div class="haerin-listening">
  <a href="https://www.youtube.com/watch?v=ArmDp-zijuc" target="_blank" rel="noopener noreferrer" aria-label="Watch NewJeans Super Shy official music video on YouTube"><span class="haerin-listening-label">ON REPEAT / MY FAVORITE</span><span class="haerin-listening-song">Super Shy <span aria-hidden="true">↗</span></span></a>
  <button type="button" class="haerin-replay" data-burst-replay aria-label="Replay Haerin stickers"><span aria-hidden="true">↻</span><span data-replay-label>REPLAY<br />STICKERS</span></button>
</div>
<div class="haerin-burst" data-haerin-burst aria-hidden="true">
  {stickers.map(([asset,x,y,size,rotation,drift],i)=><div class="haerin-sticker" data-burst-sticker style={`--sticker-x:${x}%;--sticker-y:${y}%;--sticker-size:${size}px;--sticker-turn:${rotation}deg;--sticker-drift:${drift};--sticker-order:${i}`}><img class="haerin-sticker-art" src={`/images/stickers/${asset}.svg`} alt="" width="190" height="205" loading="lazy" draggable="false" /></div>)}
</div>
<script>
  import '../scripts/haerin-burst';
</script>
