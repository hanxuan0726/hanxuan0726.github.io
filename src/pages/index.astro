---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ResourceLink from '../components/ResourceLink.astro';
import PublicationList from '../components/PublicationList.astro';
import { site } from '../data/site';
import { isConfigured, formatDate } from '../utils/links';
const github = isConfigured(site.githubUsername) ? `https://github.com/${site.githubUsername}` : null;
const email = isConfigured(site.email) ? `mailto:${site.email}` : null;
const nav = [ ['about', 'About'], ['research', 'Research'], ['projects', 'Projects'], ['experience', 'Experience'], ...(site.publications.length ? [['publications', 'Publications']] : []), ['contact', 'Contact'] ];
const updated = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${site.lastUpdated}T00:00:00Z`));
---
<Layout>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="wordmark" href="#home" aria-label={`${site.name}, back to top`}>{site.name}<span class="wordmark-dot">.</span></a>
      <nav aria-label="Main navigation"><ul>{nav.map(([id, label]) => <li><a href={`#${id}`} data-section={id}>{label}</a></li>)}</ul></nav>
      <label class="theme-picker" title="Color theme">
        <Icon name="sun" />
        <span class="sr-only">Color theme</span>
        <select id="theme-select" aria-label="Color theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select>
      </label>
    </div>
  </header>

  <main id="main" class="shell">
    <section id="home" class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow"><span class="blue-rule"></span> Embodied AI &amp; Robot Learning</div>
        <h1 id="hero-title">{site.name}</h1>
        <p class="chinese-name" lang="zh-CN">{site.chineseName}</p>
        <p class="hero-role">{site.role} <span>at</span><br class="mobile-break" /> {site.university}</p>
        <p class="hero-intro">{site.introduction}</p>
        <div class="hero-links">
          {email ? <a class="text-link" href={email}><Icon name="mail" />Email<Icon name="arrow" /></a> : <a class="text-link" href="#contact"><Icon name="mail" />Email<Icon name="arrow" /></a>}
          <span class="link-divider" aria-hidden="true"></span>
          <ResourceLink label="GitHub" url={github} placeholder="https://github.com/[USERNAME]" />
          <span class="link-divider" aria-hidden="true"></span>
          <ResourceLink label="CV" url={site.cv} placeholder="[CV_PDF]" />
        </div>
        <p class="public-email">{email ? <a href={email}>{site.email}</a> : <span>{site.email}</span>}</p>
      </div>
      <figure class="portrait">
        <div class="portrait-frame"><img src={site.portrait} alt={site.portraitAlt} width="600" height="700" fetchpriority="high" /></div>
        <figcaption>{site.portraitIsPlaceholder ? <span class="photo-note">[YOUR PORTRAIT]</span> : <span>{site.name}</span>}<span class="portrait-location"><Icon name="pin" />{site.location}</span></figcaption>
      </figure>
    </section>

    <section id="about" class="section section-split" aria-labelledby="about-title">
      <div class="section-heading"><p class="section-index">01 / Background</p><h2 id="about-title">About me</h2></div>
      <div class="prose">{site.about.map((paragraph) => <p>{paragraph}</p>)}<p class="affiliation"><span class="small-label">Affiliation</span>{site.university} <span class="muted">/</span> <span lang="zh-CN">{site.school}</span></p></div>
    </section>

    <section id="research" class="section" aria-labelledby="research-title">
      <div class="section-top"><div class="section-heading"><p class="section-index">02 / Directions</p><h2 id="research-title">Research interests</h2></div><p class="section-aside">Perception. Prediction. Action.</p></div>
      <div class="research-grid">{site.interests.map((interest, i) => <article class="research-item"><span class="interest-number">0{i + 1}</span><h3>{interest.title}</h3><p class="interest-subtitle">{interest.subtitle}</p><p>{interest.description}</p></article>)}</div>
    </section>

    <section id="projects" class="section" aria-labelledby="projects-title">
      <div class="section-top"><div class="section-heading"><p class="section-index">03 / Hands-on exploration</p><h2 id="projects-title">Selected projects</h2></div><p class="section-aside">From ideas to physical systems.</p></div>
      <div class="projects">{site.projects.map((project, i) => <article class="project" aria-labelledby={`${project.id}-title`}>
        <figure class="project-figure"><img src={project.image} alt={project.imageAlt} width="800" height="540" loading="lazy" />{project.imageIsPlaceholder && <figcaption>[PROJECT IMAGE PLACEHOLDER]</figcaption>}</figure>
        <div class="project-copy"><div class="project-meta"><span class="small-label">{String(i + 1).padStart(2, '0')} / {project.category}</span>{project.status === 'In Progress' && <span class="status"><span></span>In Progress</span>}</div><h3 id={`${project.id}-title`}>{project.title}</h3><p>{project.description}</p><ul class="tags" aria-label="Technologies">{project.tags.map((tag) => <li>{tag}</li>)}</ul><div class="resource-links">{project.links.map((link) => <ResourceLink {...link} compact />)}</div></div>
      </article>)}</div>
    </section>

    <section id="experience" class="section section-split" aria-labelledby="experience-title">
      <div class="section-heading"><p class="section-index">04 / Experience</p><h2 id="experience-title">Education</h2></div>
      <div class="education-list">{site.education.map((item) => <article class="education-item"><div class="education-line"><span class="education-mark" aria-hidden="true">E</span><div><h3>{item.institution}</h3><p class="degree">{item.degree}</p><p class="muted" lang="zh-CN">{item.school}</p><p class="education-location">{item.location}</p></div></div><p class="education-date">{item.start || item.end ? `${formatDate(item.start)}${item.start && item.end ? ' — ' : ''}${formatDate(item.end)}` : <span>[DATES TO ADD]</span>}</p></article>)}</div>
    </section>

    {site.publications.length > 0 && <section id="publications" class="section section-split" aria-labelledby="publications-title"><div class="section-heading"><p class="section-index">Publications</p><h2 id="publications-title">Selected writing</h2></div><PublicationList publications={site.publications} name={site.name} /></section>}

    <section id="contact" class="section contact-section" aria-labelledby="contact-title">
      <div><p class="section-index">05 / Get in touch</p><h2 id="contact-title">Let’s connect.</h2><p class="contact-intro">For conversations about embodied intelligence,<br class="desktop-break" /> robot learning, or shared research interests.</p></div>
      <div class="contact-details"><p class="contact-name">{site.name}</p>{email ? <a class="contact-email" href={email}>{site.email}<Icon name="arrow" /></a> : <p class="contact-email">{site.email}</p>}<p class="contact-location"><Icon name="pin" />{site.location}</p><ResourceLink label="GitHub" url={github} placeholder="https://github.com/[USERNAME]" compact /></div>
    </section>
  </main>
  <footer class="site-footer"><div class="shell footer-inner"><p>© {new Date().getUTCFullYear()} {site.name}</p><p class="footer-center">Last updated <time datetime={site.lastUpdated}>{updated}</time></p><div class="footer-links"><ResourceLink label="GitHub" url={github} placeholder="https://github.com/[USERNAME]" compact /><a href="#home">Back to top ↑</a></div></div></footer>

  <script>
    const themeSelect = document.querySelector<HTMLSelectElement>('#theme-select');
    if (themeSelect) {
      themeSelect.value = document.documentElement.dataset.theme || 'system';
      themeSelect.addEventListener('change', () => {
        document.documentElement.dataset.theme = themeSelect.value;
        try { localStorage.setItem('theme', themeSelect.value); } catch {}
      });
    }
    // Keep the current section reliable even when a section is taller than the viewport.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section]'));
    const sections = links.map((link) => document.getElementById(link.dataset.section!)).filter((section): section is HTMLElement => Boolean(section));
    let scheduled = false;
    const updateCurrent = () => {
      let current = '';
      const threshold = window.innerWidth < 760 ? 180 : 145;
      for (const section of sections) if (section.getBoundingClientRect().top <= threshold) current = section.id;
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4) current = sections.at(-1)?.id || current;
      for (const link of links) {
        if (link.dataset.section === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      scheduled = false;
    };
    const scheduleUpdate = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(updateCurrent); } };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    window.addEventListener('hashchange', scheduleUpdate);
    updateCurrent();
  </script>
</Layout>
