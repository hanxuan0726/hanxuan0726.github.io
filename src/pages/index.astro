---
import Layout from '../layouts/Layout.astro';
import ResourceLink from '../components/ResourceLink.astro';
import PublicationList from '../components/PublicationList.astro';
import TravelMap from '../components/TravelMap.astro';
import OffHours from '../components/OffHours.astro';
import '../styles/motion.css';
import { site } from '../data/site';
import { isConfigured, formatDate } from '../utils/links';
const github = `https://github.com/${site.githubUsername}`;
const email = `mailto:${site.email}`;
const nav = [['about', 'About'], ['research', 'Research'], ['projects', 'Projects'], ['travel', 'Footprints'], ['off-hours', 'Off hours'], ...(site.publications.length ? [['publications', 'Publications']] : [])];
const updated = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${site.lastUpdated}T00:00:00Z`));
---
<Layout>
  <div class="site-frame" id="home">
    <header class="site-header">
      <a class="monogram" href="#home" aria-label="Hanxuan Zhou, back to top">HZ<span aria-hidden="true">✳</span></a>
      <p class="header-note">RESEARCHER IN THE MAKING<br />SHANGHAI IS HOME</p>
      <nav aria-label="Main navigation">{nav.map(([id, label]) => <a href={`#${id}`} data-section={id}>{label}</a>)}</nav>
      <a class="header-contact" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
      <button class="page-motion-toggle" id="page-motion-toggle" type="button" aria-label="Pause all animations" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
      <button class="contrast-button" id="contrast-toggle" type="button" aria-label="Use dark contrast" aria-pressed="false"><span aria-hidden="true">◐</span></button>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-kicker mono"><span><i class="status-dot" aria-hidden="true"></i> EMBODIED AI &amp; ROBOT LEARNING</span><span>SHANGHAI / <span lang="zh-CN">周瀚轩</span></span></div>
        <h1 id="hero-title"><span>Hanxuan</span> <span>Zhou</span></h1>
        <figure class="field-art" aria-label="An interactive wireframe field, inspired by perception and motion">
          <svg class="field-fallback" viewBox="0 0 600 400" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1">{Array.from({ length: 38 }, (_, i) => <ellipse cx="300" cy="200" rx={38 + i * 6.5} ry={176 - Math.sin(i / 8) * 70} transform={`rotate(${i * 4.7} 300 200)`} />)}</g></svg>
          <canvas id="motion-field" aria-hidden="true"></canvas>
          <div class="field-cross field-cross-a" aria-hidden="true">+</div><div class="field-cross field-cross-b" aria-hidden="true">+</div>
          <figcaption class="mono"><span>PERCEPTION → ACTION</span><span>LIVE FIELD / 01</span></figcaption>
          <button type="button" id="motion-toggle" class="motion-toggle" aria-pressed="false" aria-label="Pause animation"><span aria-hidden="true">Ⅱ</span></button>
        </figure>
        <div class="hero-footer">
          <div class="hero-identity"><p>{site.role} <span class="serif">at</span></p><p>{site.university}</p>{isConfigured(site.cv) && <ResourceLink label="Curriculum vitae" url={site.cv} />}</div>
          <p class="hero-description">Exploring how machines<br />perceive, reason, <span class="serif">and act.</span></p>
          <a class="round-link" href="#projects" aria-label="Explore selected projects"><span aria-hidden="true">↓</span></a>
        </div>
      </section>
      <div class="ticker" aria-hidden="true"><div>{[0, 1, 2, 3].map(() => <span>PERCEPTION <b>↗</b> PREDICTION <b>↗</b> ACTION <b>✳</b> </span>)}</div></div>
      <section id="about" class="about-section panel" aria-labelledby="about-title">
        <div class="section-label mono"><span>01 / THE PERSON</span><span>IDEAS MEET THE REAL WORLD</span></div>
        <div class="about-grid">
          <h2 id="about-title">A curious mind.<br />A <em>physical</em><br />world.</h2>
          <div class="about-copy"><p class="intro">{site.introduction}</p>{site.about.map(paragraph => <p>{paragraph}</p>)}<a class="underlined-link" href={github} target="_blank" rel="noopener noreferrer">Find me on GitHub <span aria-hidden="true">↗</span></a></div>
        </div>
        <div id="experience" class="education-strip"><span class="mono">CURRENT CHAPTER</span>{site.education.map(item => <div><h3>{item.institution}</h3><p>{item.degree} <span aria-hidden="true">/</span> <span lang="zh-CN">{item.school}</span></p>{(item.start || item.end) && <p class="mono">{formatDate(item.start)}{item.start && item.end ? ' — ' : ''}{formatDate(item.end)}</p>}</div>)}<span class="education-emblem" aria-hidden="true">↗</span></div>
      </section>
      <section id="research" class="research-section panel" aria-labelledby="research-title">
        <div class="section-label mono"><span>02 / RESEARCH INTERESTS</span><span>OPEN QUESTIONS. NEW POSSIBILITIES.</span></div>
        <div class="research-heading"><h2 id="research-title">LEARNING<br />TO <span class="serif">act.</span></h2><p>From multimodal observations<br />to behavior in the physical world.</p></div>
        <div class="research-list">{site.interests.map((interest, i) => <details class="research-item" name="research-interest" open={i === 0}><summary><span class="mono">0{i + 1}</span><h3>{interest.title}</h3><span class="details-symbol" aria-hidden="true"></span></summary><div class="research-answer"><p class="mono">{interest.subtitle}</p><p>{interest.description}</p></div></details>)}</div>
      </section>
      <section id="projects" class="projects-section panel" aria-labelledby="projects-title">
        <div class="section-label mono"><span>03 / SELECTED EXPLORATIONS</span><span>FROM IDEAS TO PHYSICAL SYSTEMS</span></div>
        <div class="projects-heading"><h2 id="projects-title">IN THE<br /><span class="serif">making.</span></h2><span class="project-count mono">({String(site.projects.length).padStart(2, '0')})</span></div>
        <div class="projects">{site.projects.map((project, i) => <article class:list={['project', { 'project-reverse': i % 2 !== 0 }]} aria-labelledby={`${project.id}-title`}>
          <figure class="project-figure"><img src={project.image} alt={project.imageAlt} width="1200" height="850" loading="lazy" /><figcaption class="mono"><span>FIG. 0{i + 1} / CONCEPT STUDY</span><span>ILLUSTRATION, NOT EXPERIMENT FOOTAGE</span></figcaption></figure>
          <div class="project-copy"><div class="project-meta mono"><span>0{i + 1} / {project.category}</span><span class="project-status"><i class="status-dot" aria-hidden="true"></i>{project.status}</span></div><h3 id={`${project.id}-title`}>{project.title}</h3><p>{project.description}</p><ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul>
          <details class="project-notes"><summary>Explore the process <span aria-hidden="true">+</span></summary><div>{i === 0 ? <><p>A hands-on workflow with LeRobot and the SO-101, from human demonstrations to learned behavior on the physical robot.</p><ol><li>Collect manipulation demonstrations.</li><li>Train an Action Chunking Transformer policy.</li><li>Deploy for centrifuge tube pick-and-place.</li></ol></> : <><p>An ongoing exploration of the communication path between a robot and remote model inference.</p><ol><li>Transmit visual observations.</li><li>Run remote model inference.</li><li>Protect control-command integrity and authenticate communication.</li></ol></>}</div></details>
          {project.links.some(link => isConfigured(link.url)) && <div class="resource-links">{project.links.filter(link => isConfigured(link.url)).map(link => <ResourceLink {...link} />)}</div>}
          </div>
        </article>)}</div>
      </section>
      {site.publications.length > 0 && <section id="publications" class="panel publications-section" aria-labelledby="publications-title"><div class="section-label mono">SELECTED WRITING</div><h2 id="publications-title">Publications</h2><PublicationList publications={site.publications} name={site.name} /></section>}
      <TravelMap />
      <OffHours />
      <section id="contact" class="contact-section panel" aria-labelledby="contact-title">
        <div class="section-label mono"><span>06 / KEEP IN TOUCH</span><span>GOOD IDEAS START WITH A CONVERSATION</span></div>
        <a class="contact-title-link" href={email}><h2 id="contact-title">LET’S<br /><span class="serif">connect.</span></h2><span class="contact-arrow" aria-hidden="true">↗</span></a>
        <div class="contact-bottom"><p>Embodied intelligence, robot learning,<br />or a shared curiosity. Say hello.</p><div><a class="email-link" href={email}>{site.email}<span aria-hidden="true">↗</span></a><button id="copy-email" class="copy-email mono" data-email={site.email} type="button">COPY EMAIL <span aria-hidden="true">⧉</span></button><span id="copy-status" class="mono" role="status" aria-live="polite"></span></div></div>
      </section>
    </main>
    <footer class="site-footer mono"><span>© {new Date().getUTCFullYear()} {site.name} <span lang="zh-CN">/ 周瀚轩</span></span><span>CONTENT UPDATED <time datetime={site.lastUpdated}>{updated}</time></span><div><a href={github} target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a href="#home">BACK TO TOP ↑</a></div></footer>
  </div>
  <script src="../scripts/portfolio.ts"></script>
  <script src="../scripts/motion.ts"></script>
</Layout>
